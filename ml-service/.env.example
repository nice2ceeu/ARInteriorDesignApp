# Copy to .env in this directory. Run the service from ml-service/.
# First startup downloads OWLv2 weights unless this points to a local checkpoint.
OWL_MODEL_ID=google/owlv2-base-patch16-ensemble
ML_DEVICE=cpu
# Use cuda only with a compatible PyTorch/GPU installation.

# Leave blank until train_ranker.py creates a real model artifact.
LAYOUT_RANKER_PATH=
LAYOUT_RANKER_VERSION=client-v1
