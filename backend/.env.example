# Copy to backend/.env. Start the backend from its own directory.
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Leave blank for a random development key (tokens reset on restart).
# Production requires a private key. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Local MongoDB; replace with your own Atlas URI if applicable.
# Without MongoDB, development accounts are ephemeral. Production needs MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=ARINTERIORDESIGNAPP

# Private OWLv2 / XGBoost inference service.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=25000
# Optional client catalog JSON, relative to the backend working directory.
FURNITURE_CATALOG_PATH=

# Optional inspiration-photo search. Keep credentials outside the frontend bundle.
PEXELS_API_KEY=
# Alternative to PEXELS_API_KEY:
THEME_RECOMMENDATION_API_KEY=

# Optional error reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
