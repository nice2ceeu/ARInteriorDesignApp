# Copy to frontend/.env and restart Expo after changing values.
# These settings are public and are included in the app bundle.
# Web / iOS simulator:
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# Android emulator: use http://10.0.2.2:3000/api/v1 instead.
# Physical phone: use http://YOUR_COMPUTER_LAN_IP:3000/api/v1 instead.
# The phone and computer must be on the same network.

# Optional layout API override; blank uses EXPO_PUBLIC_API_BASE_URL.
EXPO_PUBLIC_LAYOUT_API_BASE_URL=

# StableDiffusionDesignService expects the server root, without /api/v1.
# Use the same host as above.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional hosted Unity WebGL build, if available.
EXPO_PUBLIC_UNITY_BUILD_URL=

# Optional error reporting.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development

# User authentication tokens are stored after login, not configured here.
# Put AI provider secrets in backend/.env.
